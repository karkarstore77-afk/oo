; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Roof Groove"
config/description="Hard  Platform Game 

By : RayyanElnahas"
config/version="1.1.7"
config/tags=PackedStringArray("1")
run/main_scene="res://SPLASH.tscn"
run/enable_alt_space_menu=true
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://branding/icon_512.png"
config/windows_native_icon="res://branding/icon.ico"

[audio]

driver/enable_input=true

[autoload]

PatchLoader="*res://scripts/patch_loader.gd"
Roles="*res://scripts/roles.gd"
HourlyNotifier="*res://scripts/hourly_notifier.gd"
Network="*res://scripts/network.gd"
IntegrityGuard="*res://scripts/integrity_guard.gd"
FriendsSystem="*res://scripts/friends_system.gd"
Updater="*res://scripts/updater.gd"
DayCycle="*res://scripts/day_cycle.gd"
GameSettings="*res://scripts/game_settings.gd"
GameAudio="*res://scripts/game_audio.gd"
VoiceChat="*res://scripts/voice_chat.gd"
Loc="*res://scripts/loc.gd"
GyroTilt="*res://scripts/gyro_tilt.gd"
UIStyle="*res://scripts/ui_style.gd"
Economy="*res://scripts/economy.gd"
TopBar="*res://scripts/top_bar.gd"
SceneTransition="*res://scripts/scene_transition.gd"

[display]

window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0
mouse_cursor/image=""
mouse_cursor/name_localized={}
mouse_cursor/version="1.1.7"

[dotnet]

project/assembly_name="RoofGroove"

[editor]

version_control/autoload_on_startup=true

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

[editor_plugins]

enabled=PackedStringArray("res://addons/GMPShared/menu/plugin.cfg", "res://addons/NotificationSchedulerPlugin/plugin.cfg")

[importer_defaults]

animation_library={
&"animation/fps": 120.0
}

[input]

PAUSE={
"deadzone": 0.2,
"events": []
}

[input_devices]

pointing/android/enable_long_press_as_right_click=true
sensors/enable_gravity=true
pointing/emulate_touch_from_mouse=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

[xr]

openxr/extensions/debug_message_types=11
openxr/extensions/hand_tracking_unobstructed_data_source=true
shaders/enabled=true
