var current: = "en"


func _ready() -> void :
	_setup_fonts()
	_build_translations()
	var code: = GameSettings.language
	if code == "":
		code = OS.get_locale_language()
	set_language(code, false)



func set_language(code: String, save: bool = true) -> void :
	if not LANGS.has(code):
		code = "en"
	current = code
	TranslationServer.set_locale(code)
	if save:
		GameSettings.language = code
		GameSettings.save_settings()


func is_rtl() -> bool:
	return current == "ar"



func _setup_fonts() -> void :
	if not ResourceLoader.exists(ARABIC_FONT_PATH):
		push_warning("Loc: Arabic font not found: " + ARABIC_FONT_PATH)
		return
	var ar_font: = load(ARABIC_FONT_PATH) as Font
	if ar_font == null:
		return
	var fb: Array[Font] = [ar_font]
	var base: = load(PIXEL_FONT_PATH) as Font
	if base != null:
		base.fallbacks = fb
	var def_font: = ThemeDB.fallback_font
	if def_font != null:
		def_font.fallbacks = fb


func _build_translations() -> void :
	var ar: = Translation.new()
	ar.locale = "ar"
	var fr: = Translation.new()
	fr.locale = "fr"
	for key in T:
		var v: Array = T[key]
		ar.add_message(StringName(key), StringName(v[0]))
		fr.add_message(StringName(key), StringName(v[1]))
	TranslationServer.add_translation(ar)
	TranslationServer.add_translation(fr)
